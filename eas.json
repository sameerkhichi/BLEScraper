{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "channel": "development"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "node": "22.14.0",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "groups": ["Internal"]
      }
    }
  }
}
